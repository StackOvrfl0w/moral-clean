+        </CardContent>
+      </Card>
+
+      <Card>
+        <CardHeader>
+          <CardTitle>5. Import options</CardTitle>
+        </CardHeader>
+        <CardContent className="space-y-4">
+          <div className="grid gap-3 md:grid-cols-2">
+            <label className={`cursor-pointer rounded-md border p-4 ${mode === "create" ? "border-accent bg-accent/5" : ""}`}>
